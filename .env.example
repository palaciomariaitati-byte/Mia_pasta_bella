# ==============================================================================
# VARIABLES DE ENTORNO PARA PRODUCCIÓN / DESPLIEGUE A LA NUBE (VERCEL & SUPABASE)
# ==============================================================================

# URL de tu proyecto en Supabase Cloud (ej: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase (Anon Key de Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-de-supabase-cloud

# Clave Service Role privada (uso exclusivo en backend / Server Actions seguras en Vercel)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# URL de producción pública de la Tienda (desplegada en Vercel)
NEXT_PUBLIC_SITE_URL=https://miapastabella.vercel.app
